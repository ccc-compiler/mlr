// An MLP that classifies handwritten digits.
//
// The network was trained with `tools/train_torch_models.py` (PyTorch) and
// the weights are embedded into the program at compile time with `mlr.load`.
//
//   784 -> 128 -> 64 -> 10, with a ReLU after every hidden layer.

fn classify(
    x: Tensor<784xf32>,
    w1: Tensor<784x128xf32>,
    b1: Tensor<128xf32>,
    w2: Tensor<128x64xf32>,
    b2: Tensor<64xf32>,
    w3: Tensor<64x10xf32>,
    b3: Tensor<10xf32>
) -> i32 {
    let h1 = relu(add_bias(matmul(x, w1), b1))
    let h2 = relu(add_bias(matmul(h1, w2), b2))
    let logits = add_bias(matmul(h2, w3), b3)
    yield argmax(logits)
}

fn main() {
    let images = mlr.load<Tensor<100x784xf32>>("examples/mlp/images.bin")
    let labels = mlr.load<Tensor<100xi32>>("examples/mlp/labels.bin")
    let w1 = mlr.load<Tensor<784x128xf32>>("examples/mlp/w1.bin")
    let b1 = mlr.load<Tensor<128xf32>>("examples/mlp/b1.bin")
    let w2 = mlr.load<Tensor<128x64xf32>>("examples/mlp/w2.bin")
    let b2 = mlr.load<Tensor<64xf32>>("examples/mlp/b2.bin")
    let w3 = mlr.load<Tensor<64x10xf32>>("examples/mlp/w3.bin")
    let b3 = mlr.load<Tensor<10xf32>>("examples/mlp/b3.bin")

    // The loop counts the correctly classified images.
    let correct = for i in 0..100 step 1 iter(acc = 0) {
        let img = row(images, i)
        let pred = classify(img, w1, b1, w2, b2, w3, b3)
        let label = tensor.extract(labels, [i])
        if pred == label {
            yield acc + 1
        } else {
            yield acc
        }
    }
    print(correct)
    print(correct / 100.0)
}
