// A GPT that writes text, one byte at a time.
//
// The model is a causal transformer with two layers, two heads and a width of
// thirty two (pre layer normalization, gelu in the feed forward network). It
// was trained with `tools/train_torch_models.py` (PyTorch) on the corpus of
// `examples/lm/input.txt` and the weights are embedded into the program at
// compile time with `mlr.load`.
//
// The corpus is read as bytes, so the generated text is written byte by byte
// with `print_byte`. The weights of a layer are bundled into a `struct`, so
// that the forward pass reads like the model and not like a list of sixteen
// parameters.
//
//   attention    p = softmax((q k^T / sqrt(d)) masked) v
//   head h       out_h = p_h v_h, merged = sum_h out_h proj_h
//   block        x = x + attn(ln1 x), x = x + fc2 gelu(fc1 ln2 x)

struct Attention {
    wq0: Tensor<32x16xf32>,
    wk0: Tensor<32x16xf32>,
    wv0: Tensor<32x16xf32>,
    wproj0: Tensor<16x32xf32>,
    wq1: Tensor<32x16xf32>,
    wk1: Tensor<32x16xf32>,
    wv1: Tensor<32x16xf32>,
    wproj1: Tensor<16x32xf32>
}

struct Block {
    ln1_g: Tensor<32xf32>,
    ln1_b: Tensor<32xf32>,
    ln2_g: Tensor<32xf32>,
    ln2_b: Tensor<32xf32>,
    attn: Attention,
    fc1: Tensor<32x128xf32>,
    fc2: Tensor<128x32xf32>
}

impl Attention {
    // One head: the masked scores and the weighted values.
    fn head(self, x: Tensor<16x32xf32>, wq: Tensor<32x16xf32>, wk: Tensor<32x16xf32>,
            wv: Tensor<32x16xf32>) -> Tensor<16x16xf32> {
        let q = matmul(x, wq)
        let k = matmul(x, wk)
        let v = matmul(x, wv)
        let scaled = map(matmul(q, transpose(k))) |e| {
            yield e * 0.25
        }
        let p = softmax_causal(self.causal(scaled), 16)
        yield matmul(p, v)
    }

    // The causal mask: the scores of the future are set to a large negative
    // number, so that the softmax ignores them.
    fn causal(self, s: Tensor<16x16xf32>) -> Tensor<16x16xf32> {
        yield for i in 0..16 step 1 iter(m = s) {
            yield for j in 0..16 step 1 iter(m2 = m) {
                if j > i {
                    yield tensor.insert(m2, [i, j], -1000000.0)
                } else {
                    yield m2
                }
            }
        }
    }

    fn forward(self, x: Tensor<16x32xf32>) -> Tensor<16x32xf32> {
        let a0 = self.head(x, self.wq0, self.wk0, self.wv0)
        let a1 = self.head(x, self.wq1, self.wk1, self.wv1)
        yield map(matmul(a0, self.wproj0), matmul(a1, self.wproj1)) |a, b| {
            yield a + b
        }
    }
}

impl Block {
    fn forward(self, x: Tensor<16x32xf32>) -> Tensor<16x32xf32> {
        let h = layernorm(x, self.ln1_g, self.ln1_b)
        let merged = self.attn.forward(h)
        let x2 = map(x, merged) |a, b| {
            yield a + b
        }
        let h2 = layernorm(x2, self.ln2_g, self.ln2_b)
        let g = map(matmul(h2, self.fc1)) |e| {
            yield gelu(e)
        }
        let f = matmul(g, self.fc2)
        yield map(x2, f) |a, b| {
            yield a + b
        }
    }
}

fn main() {
    let wte = mlr.load<Tensor<66x32xf32>>("examples/gpt/wte.bin")
    let wpe = mlr.load<Tensor<16x32xf32>>("examples/gpt/wpe.bin")
    let l0 = Block {
        ln1_g: mlr.load<Tensor<32xf32>>("examples/gpt/layer0_ln1_g.bin"),
        ln1_b: mlr.load<Tensor<32xf32>>("examples/gpt/layer0_ln1_b.bin"),
        ln2_g: mlr.load<Tensor<32xf32>>("examples/gpt/layer0_ln2_g.bin"),
        ln2_b: mlr.load<Tensor<32xf32>>("examples/gpt/layer0_ln2_b.bin"),
        attn: Attention {
            wq0: mlr.load<Tensor<32x16xf32>>("examples/gpt/layer0_wq0.bin"),
            wk0: mlr.load<Tensor<32x16xf32>>("examples/gpt/layer0_wk0.bin"),
            wv0: mlr.load<Tensor<32x16xf32>>("examples/gpt/layer0_wv0.bin"),
            wproj0: mlr.load<Tensor<16x32xf32>>("examples/gpt/layer0_wproj0.bin"),
            wq1: mlr.load<Tensor<32x16xf32>>("examples/gpt/layer0_wq1.bin"),
            wk1: mlr.load<Tensor<32x16xf32>>("examples/gpt/layer0_wk1.bin"),
            wv1: mlr.load<Tensor<32x16xf32>>("examples/gpt/layer0_wv1.bin"),
            wproj1: mlr.load<Tensor<16x32xf32>>("examples/gpt/layer0_wproj1.bin")
        },
        fc1: mlr.load<Tensor<32x128xf32>>("examples/gpt/layer0_fc1.bin"),
        fc2: mlr.load<Tensor<128x32xf32>>("examples/gpt/layer0_fc2.bin")
    }
    let l1 = Block {
        ln1_g: mlr.load<Tensor<32xf32>>("examples/gpt/layer1_ln1_g.bin"),
        ln1_b: mlr.load<Tensor<32xf32>>("examples/gpt/layer1_ln1_b.bin"),
        ln2_g: mlr.load<Tensor<32xf32>>("examples/gpt/layer1_ln2_g.bin"),
        ln2_b: mlr.load<Tensor<32xf32>>("examples/gpt/layer1_ln2_b.bin"),
        attn: Attention {
            wq0: mlr.load<Tensor<32x16xf32>>("examples/gpt/layer1_wq0.bin"),
            wk0: mlr.load<Tensor<32x16xf32>>("examples/gpt/layer1_wk0.bin"),
            wv0: mlr.load<Tensor<32x16xf32>>("examples/gpt/layer1_wv0.bin"),
            wproj0: mlr.load<Tensor<16x32xf32>>("examples/gpt/layer1_wproj0.bin"),
            wq1: mlr.load<Tensor<32x16xf32>>("examples/gpt/layer1_wq1.bin"),
            wk1: mlr.load<Tensor<32x16xf32>>("examples/gpt/layer1_wk1.bin"),
            wv1: mlr.load<Tensor<32x16xf32>>("examples/gpt/layer1_wv1.bin"),
            wproj1: mlr.load<Tensor<16x32xf32>>("examples/gpt/layer1_wproj1.bin")
        },
        fc1: mlr.load<Tensor<32x128xf32>>("examples/gpt/layer1_fc1.bin"),
        fc2: mlr.load<Tensor<128x32xf32>>("examples/gpt/layer1_fc2.bin")
    }
    let ln_f_g = mlr.load<Tensor<32xf32>>("examples/gpt/ln_f_g.bin")
    let ln_f_b = mlr.load<Tensor<32xf32>>("examples/gpt/ln_f_b.bin")
    let lm_head = mlr.load<Tensor<32x66xf32>>("examples/gpt/lm_head.bin")
    let prompt = mlr.load<Tensor<16xi32>>("examples/gpt/prompt.bin")
    // The table that maps a token index back to its byte.
    let vocab = mlr.load<Tensor<66xi32>>("examples/gpt/vocab.bin")

    // The prompt is written first.
    let pad = for i in 0..16 step 1 iter(n = 0) {
        print_byte(tensor.extract(vocab, [tensor.extract(prompt, [i])]))
        yield n
    }

    // The loop keeps a window of sixteen tokens: the logits of the last
    // position give the next one, and the window slides by one.
    let text = for step in 0..32 step 1 iter(tokens = prompt) {
        let x = map(embed_seq(wte, tokens), wpe) |a, b| {
            yield a + b
        }
        let x1 = l0.forward(x)
        let x2 = l1.forward(x1)
        let h = layernorm(x2, ln_f_g, ln_f_b)
        let logits = row(matmul(h, lm_head), 15)
        let next = sample(logits, 0.8, step + 12345)
        print_byte(tensor.extract(vocab, [next]))
        yield for j in 0..16 step 1 iter(t = tokens) {
            if j < 15 {
                yield tensor.insert(t, [j], tensor.extract(tokens, [j + 1]))
            } else {
                yield tensor.insert(t, [j], next)
            }
        }
    }
    print_byte(10)
}
