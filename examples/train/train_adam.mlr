// Adam in MLR: a softmax regression (784 -> 10) on the hundred MNIST
// images, trained with the Adam update, written in the language itself.
//
// Every parameter carries its first and second moment in the loop; the loop
// unpacks into all of its loop-carried values (`let (w, mw, ...) = for
// ...`), so no struct is needed. The bias corrections are the powers c1 =
// 0.9^t and c2 = 0.999^t, accumulated as products.

fn loss(w: Tensor<784x10xf32>, b: Tensor<10xf32>, x: Tensor<100x784xf32>, y: Tensor<100xi32>) -> f32 {
    yield cross_entropy(add_bias(matmul(x, w), b), y)
}

fn main() {
    let x = mlr.load<Tensor<100x784xf32>>("examples/train/images.bin")
    let y = mlr.load<Tensor<100xi32>>("examples/train/labels.bin")

    let (w, b, mw, vw, mb, vb, n1, n2) = for step in 0..200 step 1 iter(
        w = mlr.load<Tensor<784x10xf32>>("examples/train/aw.bin"),
        b = mlr.load<Tensor<10xf32>>("examples/train/ab.bin"),
        mw = tensor.zeros<Tensor<784x10xf32>>(),
        vw = tensor.zeros<Tensor<784x10xf32>>(),
        mb = tensor.zeros<Tensor<10xf32>>(),
        vb = tensor.zeros<Tensor<10xf32>>(),
        c1 = 1.0,
        c2 = 1.0
    ) {
        let (l, dw, db, _, _) = value_and_grad(loss, w, b, x, y)
        if step % 40 == 0 {
            print(l)
        }
        // The moments.
        let mw = map(mw, dw) |m, g| { yield 0.9 * m + 0.1 * g }
        let vw = map(vw, dw) |v, g| { yield 0.999 * v + 0.001 * (g * g) }
        let mb = map(mb, db) |m, g| { yield 0.9 * m + 0.1 * g }
        let vb = map(vb, db) |v, g| { yield 0.999 * v + 0.001 * (g * g) }
        // The bias corrections: c1 = 0.9^t, c2 = 0.999^t, updated before the
        // step, so that the first correction is the one of t = 1.
        let n1 = c1 * 0.9
        let n2 = c2 * 0.999
        // The update.
        let mh = map(mw) |m| { yield m / (1.0 - n1) }
        let vh = map(vw) |v| { yield v / (1.0 - n2) }
        let step_w = map(mh, vh) |m, v| { yield m / (sqrt(v) + 0.00000001) }
        let w = map(w, step_w) |a, s| { yield a - 0.002 * s }
        let mh2 = map(mb) |m| { yield m / (1.0 - n1) }
        let vh2 = map(vb) |v| { yield v / (1.0 - n2) }
        let step_b = map(mh2, vh2) |m, v| { yield m / (sqrt(v) + 0.00000001) }
        let b = map(b, step_b) |a, s| { yield a - 0.002 * s }
        yield w, b, mw, vw, mb, vb, n1, n2
    }
    print(tensor.extract(w, [0, 0]))
}
