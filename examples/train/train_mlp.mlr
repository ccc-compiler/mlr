// Training an MLP on MNIST inside MLR.
//
// The weights start from small random values (`examples/train/w*.bin`) and
// the loop of `main` runs full batch gradient descent: every step computes
// the loss and the gradients with `value_and_grad` and yields new weights.
// The trained weights are written back with `mlr.save_pt`, and the accuracy
// of the final weights is counted at the end.
//
//   784 -> 128 -> 64 -> 10, with a ReLU after every hidden layer.

struct Mlp {
    w1: Tensor<784x128xf32>,
    b1: Tensor<128xf32>,
    w2: Tensor<128x64xf32>,
    b2: Tensor<64xf32>,
    w3: Tensor<64x10xf32>,
    b3: Tensor<10xf32>
}

// The loss of the batch: the mean cross entropy of the logits.
fn loss(
    w1: Tensor<784x128xf32>,
    b1: Tensor<128xf32>,
    w2: Tensor<128x64xf32>,
    b2: Tensor<64xf32>,
    w3: Tensor<64x10xf32>,
    b3: Tensor<10xf32>,
    x: Tensor<100x784xf32>,
    y: Tensor<100xi32>
) -> f32 {
    let h1 = relu(add_bias(matmul(x, w1), b1))
    let h2 = relu(add_bias(matmul(h1, w2), b2))
    let logits = add_bias(matmul(h2, w3), b3)
    yield cross_entropy(logits, y)
}

// The digit of one image.
fn predict(m: Mlp, img: Tensor<784xf32>) -> i32 {
    let h1 = relu(add_bias(matmul(img, m.w1), m.b1))
    let h2 = relu(add_bias(matmul(h1, m.w2), m.b2))
    let logits = add_bias(matmul(h2, m.w3), m.b3)
    yield argmax(logits)
}

fn main() {
    let x = mlr.load<Tensor<100x784xf32>>("examples/train/images.bin")
    let y = mlr.load<Tensor<100xi32>>("examples/train/labels.bin")
    let start = Mlp {
        w1: mlr.load<Tensor<784x128xf32>>("examples/train/w1.bin"),
        b1: mlr.load<Tensor<128xf32>>("examples/train/b1.bin"),
        w2: mlr.load<Tensor<128x64xf32>>("examples/train/w2.bin"),
        b2: mlr.load<Tensor<64xf32>>("examples/train/b2.bin"),
        w3: mlr.load<Tensor<64x10xf32>>("examples/train/w3.bin"),
        b3: mlr.load<Tensor<10xf32>>("examples/train/b3.bin")
    }

    // Full batch gradient descent.
    let trained = for step in 0..300 step 1 iter(state = start) {
        let (l, dw1, db1, dw2, db2, dw3, db3, _, _) = value_and_grad(
            loss, state.w1, state.b1, state.w2, state.b2, state.w3, state.b3, x, y
        )
        if step % 50 == 0 {
            print(l)
        }
        yield state with {
            w1: map(state.w1, dw1) |a, g| { yield a - 0.5 * g },
            b1: map(state.b1, db1) |a, g| { yield a - 0.5 * g },
            w2: map(state.w2, dw2) |a, g| { yield a - 0.5 * g },
            b2: map(state.b2, db2) |a, g| { yield a - 0.5 * g },
            w3: map(state.w3, dw3) |a, g| { yield a - 0.5 * g },
            b3: map(state.b3, db3) |a, g| { yield a - 0.5 * g }
        }
    }

    // The trained weights are written back for later use.
    mlr.save_pt("examples/train/trained.pt",
        trained.w1, "w1", trained.b1, "b1",
        trained.w2, "w2", trained.b2, "b2",
        trained.w3, "w3", trained.b3, "b3")

    // The accuracy of the trained weights on the same hundred images.
    let correct = for i in 0..100 step 1 iter(acc = 0) {
        let img = row(x, i)
        let label = tensor.extract(y, [i])
        if predict(trained, img) == label {
            yield acc + 1
        } else {
            yield acc
        }
    }
    print(correct)
}
